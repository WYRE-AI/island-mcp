# Island API key (custom Api-Key header, generated in the Island Management
# Console -> Modules > Platform Settings > System Settings > Integrations >
# API -> + Create, with the "Read Only" role selected). This connector only
# ever holds a live API key - no OAuth flow exists for Island's Management
# API.
# Used by stdio and by HTTP only when AUTH_MODE=env. The gateway Compose
# service does not load these. Do not add them to that service's environment
# or via env_file. Gateway mode requires the X-Island-Api-Key header on each
# request (X-Island-Base-URL is optional).
ISLAND_API_KEY=

# Optional override of the Island Management API base URL. Defaults to
# https://management.island.io/api if unset - set this only if your Island
# administrator gave you a different host for your tenant. Region is not a
# credential. Gateway compose does not interpolate this.
ISLAND_BASE_URL=

# Transport: stdio (default) or http
# MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
# Bind address. With a real CONDUIT_S2S_SECRET, an unset MCP_HTTP_HOST stays
# 0.0.0.0 so container deploys keep the historical bind. The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only. A loopback MCP_HTTP_HOST
# (localhost, ::1, or 127.0.0.0/8) is accepted and still listens on 127.0.0.1.
# A non-loopback value refuses to start.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, replace-with-a-real-secret, and the other example values).
# Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged. Leave this empty.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Island-Api-Key header; no env fallback). X-Island-Base-URL is optional.
# The container image and Compose service set gateway. Stdio ignores this and
# reads ISLAND_* from the environment.
# AUTH_MODE=env

# Log level: debug, info, warn, error
# LOG_LEVEL=info
